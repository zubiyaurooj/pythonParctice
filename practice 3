#Logical Operators
#x = 10
#y = 5

# AND → both conditions must be True
#print(x > 5 and y < 10)   # True (both are True)
#print(x > 5 and y > 10)   # False (second is False)

# OR → at least one condition must be True
#print(x > 5 or y > 10)    # True (first is True)
#print(x < 5 or y > 10)    # False (both False)

# NOT → reverses the condition
#print(not (x > 5))        # False (x>5 is True, so not True → False)
#print(not (x < 5))        # True (x<5 is False, so not False → True)

